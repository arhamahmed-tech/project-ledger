{
  "version": 1,
  "hooks": {
    "beforeSubmitPrompt": [
      {
        "command": "node scripts/ledger.mjs context"
      },
      {
        "command": "node scripts/ledger.mjs onboard"
      },
      {
        "command": "bash .cursor/hooks/toolkit-reminder.sh"
      }
    ],
    "stop": [
      {
        "command": "bash .cursor/hooks/stop-toolkit-check.sh",
        "loop_limit": 1
      }
    ]
  }
}
