{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project-ledger://schemas/EVIDENCE.json",
  "title": "EVIDENCE",
  "type": "object",
  "required": ["id", "kind", "agent_run", "path"],
  "properties": {
    "id": { "type": "string", "pattern": "^EVD-[0-9]+$" },
    "kind": { "type": "string", "enum": ["test", "review", "deploy", "manual", "other", "note"] },
    "agent_run": { "type": ["string", "null"], "pattern": "^RUN-[0-9]+$" },
    "task": { "type": ["string", "null"], "pattern": "^TASK-[0-9]+$" },
    "command": { "type": "string" },
    "path": { "type": "string" },
    "result": {
      "type": "string",
      "enum": ["pass", "fail", "not_run", "blocked", "waived", "n/a"],
      "description": "not_run/blocked/fail never count as pass for done; n/a treated as not_run"
    },
    "code_state": {
      "type": "string",
      "description": "Hash of task.files working tree at verification time"
    },
    "git_head": { "type": ["string", "null"] },
    "recorded_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": true
}
